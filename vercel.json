{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 15,
      "includeFiles": [
        "admin/**",
        "assets/**",
        "en/**",
        "mk/**",
        "about/**",
        "contact/**",
        "vehicles/**",
        "styles.css",
        "app.js",
        "data.js",
        "index.html",
        "vehicle-detail.html",
        "robots.txt",
        "sitemap.xml"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
