{
  "version": 2,
  "trailingSlash": false,
  "functions": {
    "api/index.js": {
      "maxDuration": 15,
      "includeFiles": "{admin/**,assets/**,en/**,mk/**,about/**,contact/**,vehicles/**,styles.css,app.js,data.js,index.html,vehicle-detail.html}"
    }
  },
  "rewrites": [
